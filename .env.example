# Settings the site needs on the server. Copy this file to .env (for a local run) or enter the same
# names in your hosting service's "environment variables" screen. Never commit real values.

# Database (public values: safe in the browser)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Discord sign-in (Discord developer portal -> your application -> OAuth2)
# Add https://YOUR-DOMAIN/api/public/discord/callback under Redirects there.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Any long random text; it signs the sign-in cookie.
DISCORD_SESSION_SECRET=""
# The bot (Bot -> Reset Token). Used for roles, profile pictures, DMs and giving roles.
DISCORD_BOT_TOKEN=""

# Admin sign-in with Google (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, type Web application).
# Add https://YOUR-DOMAIN/api/public/google/callback under Authorized redirect URIs there.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google account emails allowed to sign in as admin, separated by commas.
APEX_ADMIN_EMAILS=""

# Discord user IDs that always have full staff access, separated by commas.
APEX_ADMIN_DISCORD_IDS=""

# Where records are kept: on Cloudflare, a KV namespace bound as APEX_DATA (not set here, see HOSTING.md).
# On a plain Node server, this folder; it must survive restarts and redeploys. Defaults to .local-data.
APEX_DATA_DIR=""

# Optional. Leave empty unless you have the database's secret key: with it, records go to the database instead.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional, Node server only. The port the server listens on.
PORT=""